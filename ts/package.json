{
  "name": "base62-ts",
  "version": "1.4.0",
  "description": "Custom Base-62 Encoder in TypeScript",
  "main": "dist/lib/src/typescript/index.js",
  "types": "dist/lib/src/typescript/index.d.ts",
  "scripts": {
    "bundle": "esbuild lib/src/typescript/index.ts --bundle --outfile=dist/base62-${npm_package_version}.js --platform=browser --format=iife --global-name=base62 --sourcemap",
    "minify": "esbuild lib/src/typescript/index.ts --bundle --minify --outfile=dist/base62-${npm_package_version}.min.js --platform=browser --format=iife --global-name=base62",
    "compile": "eslint lib/**/*.ts && tsc",
    "fix": "eslint lib/**/*.ts --fix",
    "test": "tsc && esbuild test/src/typescript/node.spec.ts --bundle --outfile=dist/test/node.spec.cjs --platform=node --format=cjs && mocha dist/test/node.spec.cjs && esbuild test/src/typescript/browser.spec.ts --bundle --outfile=dist/test/src/typescript/index.js --platform=browser --format=iife && live-server --port=10001 --mount=/:test/src/typescript",
    "test-browser": "esbuild test/src/typescript/browser.spec.ts --bundle --outfile=dist/test/src/typescript/index.js --platform=browser --format=iife && live-server --port=10001 --mount=/:test/src/typescript",
    "test-node": "tsc && esbuild test/src/typescript/node.spec.ts --bundle --outfile=dist/test/node.spec.cjs --platform=node --format=cjs && mocha dist/test/node.spec.cjs",
    "fix-test": "eslint test/**/*.ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrildever/base62.git"
  },
  "keywords": [
    "base62",
    "base-62",
    "encoder",
    "decoder"
  ],
  "author": "Cyril Dever <cdever@pep-s.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cyrildever/base62/issues"
  },
  "homepage": "https://github.com/cyrildever/base62#readme",
  "dependencies": {
    "ts-utls": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.4",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "buffer": "^6.0.3",
    "chai": "^6.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-no-loops": "^0.4.0",
    "globals": "^17.11.0",
    "mocha": "^11.8.0",
    "typescript": "^6.0.3"
  }
}
